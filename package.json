{
  "name": "deskpet",
  "version": "6.0.0",
  "description": "可互动型桌宠程序 - 可移植、美术资源可自替换",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run watch-main\" \"npm run watch-renderer\" \"wait-on dist/main/main/index.js dist/renderer/index.html && electron .\"",
    "watch-main": "tsc -p tsconfig.main.json -w",
    "watch-renderer": "webpack --config webpack.renderer.config.js --watch",
    "build": "npm run build-main && npm run build-renderer && electron-builder",
    "build-main": "tsc -p tsconfig.main.json",
    "build-renderer": "webpack --config webpack.renderer.config.js",
    "test": "node scripts/verify-actions.mjs",
    "test:winapi": "node scripts/test-winapi.cjs",
    "verify": "node scripts/verify-build.mjs",
    "verify-actions": "node scripts/verify-actions.mjs",
    "frame-usage": "node scripts/frame-usage.mjs",
    "repack-portable": "node scripts/repack-portable.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "koffi": "^3.1.6",
    "pixi.js": "^8.3.4"
  },
  "build": {
    "appId": "com.deskpet.app",
    "productName": "DeskPet",
    "win": {
      "target": "portable",
      "sign": false
    },
    "portable": {
      "artifactName": "DeskPet-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/koffi/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asar": true
  }
}
